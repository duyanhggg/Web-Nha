# COPY file này thành .env và điền thông tin của bạn
# Đảm bảo file .env được thêm vào .gitignore để không bị lộ lên Github!
TWILIO_ACCOUNT_SID=your_account_sid_from_twilio_dashboard
TWILIO_AUTH_TOKEN=your_auth_token_from_twilio_dashboard
TWILIO_PHONE_NUMBER=+84xxxxxxxxx # Số điện thoại bạn mua từ Twilio (định dạng +84)